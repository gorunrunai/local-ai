# Copy to .env. Everything binds to localhost; nothing here enables network access.

# Backend (orchestrator) bind address. Keep loopback unless you deliberately expose it
# (e.g. over Tailscale for the mobile app) — see README > Remote access.
APP_HOST=127.0.0.1
APP_PORT=8000
# Default for phone access before it is first switched in Settings → Phone access (then the
# choice saved in data/remote_access.json wins). Proxied requests always need the token.
REMOTE_ACCESS=false

# Set to 1 only while running `make models` (the runtime stays offline otherwise).
ALLOW_MODEL_DOWNLOADS=0

